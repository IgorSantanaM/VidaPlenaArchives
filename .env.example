# Host ports for Docker Compose.
FRONTEND_PORT=5173
API_PORT=8080

# Path on your computer to an existing Google Application Default Credentials
# or service-account JSON file. Use forward slashes for Windows paths.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-application-credentials.json

# Existing Google Cloud Storage bucket and Cloud CDN signing configuration.
GOOGLE_STORAGE_BUCKET_NAME=
# HTTPS origin only, for example https://documents.example.com (no path or port).
GOOGLE_STORAGE_CDN_BASE_URL=
GOOGLE_STORAGE_CDN_KEY_NAME=documents-key
# Base64url-encoded 16-byte signing key configured on your Cloud CDN backend.
GOOGLE_STORAGE_CDN_SIGNING_KEY=
GOOGLE_STORAGE_SIGNED_URL_MINUTES=15
