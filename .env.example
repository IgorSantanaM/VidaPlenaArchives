# Host ports for Docker Compose.
FRONTEND_PORT=5173
API_PORT=8080

# Path on your computer to an existing Google Application Default Credentials
# or service-account JSON file. Use forward slashes for Windows paths.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-application-credentials.json

# Existing Google Cloud Storage bucket. Documents are served through the API.
GOOGLE_STORAGE_BUCKET_NAME=
